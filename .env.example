# Copy to .env. Local backend reads this file from the repository root.
DATABASE_URL=postgresql+psycopg://datapilot:datapilot_local@localhost:5432/datapilot
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_local
POSTGRES_DB=datapilot
DATA_DIR=./data/runtime
CORS_ORIGINS=["http://localhost:3000"]
AUTH_TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
SESSION_COOKIE_SECURE=false
SESSION_HOURS=24
LLM_PROVIDER=mock
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
WORKFLOW_TIMEOUT_SECONDS=90
SQL_REPAIR_ENABLED=true
AGENT_ENABLED=true
# Compatible endpoints require explicit native tool capability opt-in.
AGENT_NATIVE_TOOLS=false
AGENT_MAX_MODEL_CALLS=3
AGENT_MAX_TOOL_CALLS=4
AGENT_TOKEN_BUDGET=64000
# Independent from chat. none means RAG indexing is unavailable, not silently fake.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=20
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.20
KNOWLEDGE_REQUESTS_PER_WINDOW=10
# Application opt-in. LANGSMITH_TRACING alone never exports raw graph/Agent data.
DATAPILOT_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datapilot-metadata
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
MAX_UPLOAD_BYTES=10485760
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=100
MAX_RESULT_ROWS=1000
MAX_RESULT_BYTES=1048576
QUERY_TIMEOUT_SECONDS=5
ANALYSIS_REQUESTS_PER_WINDOW=30
UPLOAD_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
