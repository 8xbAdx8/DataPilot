    {
      "id": "alias",
      "question": "各division的服务实收是多少？请使用已登记业务口径，仅输出division和service_net两列，按division升序。",
      "http_status": 201,
      "status": "success",
      "sql": "SELECT \"data\".\"division\" AS \"division\", SUM(\"data\".\"fee\") - SUM(\"data\".\"labor\") AS \"service_net\" FROM \"data\" AS \"data\" WHERE \"data\".\"state\" = 'closed' GROUP BY \"data\".\"division\" ORDER BY \"division\" ASC",
      "rows": [
        {
          "division": "North",
          "service_net": 50
        },
        {
          "division": "South",
          "service_net": 22
        }
      ],
