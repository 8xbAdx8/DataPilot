  "cases": [
    {
      "id": "p25-01",
      "query": "请按已登记结单净额（别名净收）口径计算，总列名 net_amount；保留 NULL 语义。",
      "kind": "metric",
      "expected_sources": [
        "margin"
      ],
      "expected_status": "success",
      "reference_sql": "SELECT SUM(fee)-SUM(cost) AS net_amount FROM data WHERE state='closed'",
      "columns": [
        "net_amount"
      ],
      "rows": [
        [
          25
        ]
      ],
      "label_basis": "closed行fee之和30、cost之和5；两个SUM分别忽略NULL，30-5=25。SUM(fee-cost)=8，不等价。",
      "intent_group": "p25-null-safe-registered-margin"
    },
    {
